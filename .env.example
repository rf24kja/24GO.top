# Generate a secret with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# This development key is not a replacement for user authentication.
PUBLISH_API_KEY=
HOST=127.0.0.1
PORT=3000
# Optional public HTTPS origin for canonical and RSS URLs.
SITE_URL=

# Storage mode. 'local' is the default; 'supabase-readonly' disables all POST /api/posts requests.
# Set these values only when opting in to a disposable test database already using the migration.
# Publishable (sb_publishable_...) ONLY; do not use Supabase secret/service_role keys.
POST_STORE=local
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
