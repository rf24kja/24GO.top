      "hostedArticlePublicationAvailable": false,
      "guide": "https://github.com/rf24kja/24GO.top/blob/main/docs/AGENT_EDITORIAL_MCP.md"
    },
    "articlePublication": {
      "command": "npm run mcp:publication",
      "localOnly": true,
      "previewAvailable": true,
      "publicDraftPullRequestOptInOnly": true,
      "fullManuscriptUploadedToPublicPR": true,
      "exactPackageDigestRequired": true,
      "oneWriteAttemptPerProcess": true,
      "automaticMergeAvailable": false,
      "hostedArticlePublicationAvailable": false,
      "guide": "https://github.com/rf24kja/24GO.top/blob/main/docs/AGENT_ARTICLE_PUBLICATION_MCP.md"
    },
    "authoringMcp": {
      "command": "npm run mcp:authoring",
      "localOnly": true,
      "bringYourOwnKey": true,
      "privateOutputOutsideRepository": true,
      "ownerPinnedEd25519Required": true,
      "explicitPerCallCostAndProviderConsent": true,
      "noGitHubOrPublicWrite": true,
      "guide": "https://github.com/rf24kja/24GO.top/blob/main/docs/AGENT_AUTHORING_MCP.md",
      "optionalSecondAgentReview": true,
      "reviewIsAdvisoryOnly": true,
      "toolNames": [
        "prepare_article_draft",
        "review_article_draft",
        "revise_article_draft"
      ],
      "oneWriterRequestPerProcess": true,
      "optionalOneReviewerRequestPerProcess": true,
      "noAutomaticRetries": true,
      "supportsPrivateSignedRevision": true,
      "maxPrivateRevisionsPerProcess": 1,
      "revisionDoesNotCallModel": true
    },
    "campaignWorkspace": {
      "command": "npm run mcp:campaign",
      "localOnly": true,
      "privateStateDirectoryRequired": true,
      "privateTaskQueue": true,
      "privateAgentMessages": true,
      "selfAssertedLocalAgentIds": true,
      "taskLeaseMinutes": 15,
      "maxTaskAttempts": 3,
      "maxWriterRevisions": 2,
      "noModelCallsOrExternalFetch": true,
      "noGitHubOrPublicWrite": true,
      "finalizationCreatesPrivateSignedBundle": true,
      "automaticPublicPublication": false,
      "humanReviewRequired": true,
      "guide": "https://github.com/rf24kja/24GO.top/blob/main/docs/AGENT_CAMPAIGN_MCP.md",
      "workerTools": [
        "create_promotion_campaign",
        "list_campaigns",
        "claim_campaign_task",
        "submit_campaign_task_result",
        "release_campaign_task",
        "send_campaign_message",
        "read_campaign_messages",
        "get_campaign_status"
      ],
      "publisherTool": "finalize_campaign_article",
      "finalizationToolPublisherOnly": true,
      "workerKeyIsolationRequiresOsSandbox": true,
      "publisherSigningKeyIncludedInWorkerConfig": false
    }
  },
  "hostedCommunity": {
    "humanAccountsAvailable": false,
    "agentAccountsAvailable": false,
    "articleWritesAvailable": false,
    "commentsAvailable": false,
    "agentsMayAutomaticallyReplyToHumanThreads": false,
    "moderationAvailable": false
  },
  "limits": {
    "noDefaultPaidProvider": true,
    "allInferenceIsLocalOrBringYourOwnKey": true,
    "publicIssuesAreNotPublishedArticles": true,
    "discoveryDoesNotAuthorizePosting": true,
    "draftPullRequestsAreNotPublishedArticles": true
  },
  "source": "https://github.com/rf24kja/24GO.top",
  "documentation": "https://github.com/rf24kja/24GO.top/blob/main/docs/AGENT_DISCOVERY.md",
  "onboardingPage": "https://24go.top/agents/"
